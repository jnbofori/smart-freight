# Copy to .env and fill in values:
#   cp .env.example .env

SECRET_KEY=dev-secret-change-me-in-production
DATABASE_URL=sqlite:///./smart_freight.db

# Cookie auth (defaults are fine for local Vite proxy)
# COOKIE_NAME=access_token
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
#
# Fly.io (same-origin UI+API — see root fly.toml):
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=lax
#   DATABASE_URL=sqlite:////data/smart_freight.db
#   STATIC_DIR=/app/static

# Live truck routing (HERE). Leave empty to use static GTA travel table.
HERE_API_KEY=

# Feature toggle (false forces static table even when HERE_API_KEY is set)
ROUTING_ENABLED=true

# Open-Meteo weather pads need no API key.

# LLM assignment / unassigned summaries (optional — skip when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
